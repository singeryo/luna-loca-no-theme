---
import { render } from 'astro:content';
import Button from '../../components/ui/Button.astro';
import PageLayout from '../../layouts/PageLayout.astro';
import { formatNewsDate, getPublishedNews } from '../../lib/news';

export async function getStaticPaths() {
  const entries = await getPublishedNews();
  return entries.map((entry) => ({
    params: { id: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<PageLayout title={entry.data.title} description={entry.data.description}>
  <article class="section-pad">
    <div class="container-narrow max-w-3xl">
      <Button href="/actualites/" variant="ghost" class="mb-10">
        ← Toutes les actualités
      </Button>

      <header class="border-b border-ink pb-8">
        <time
          datetime={entry.data.pubDate.toISOString()}
          class="text-xs font-medium uppercase tracking-[0.18em] text-accent-blue"
        >
          {formatNewsDate(entry.data.pubDate)}
        </time>
        <h1 class="mt-4 font-display text-4xl leading-[1.05] text-ink sm:text-6xl">
          {entry.data.title}
        </h1>
        <p class="mt-5 text-lg leading-relaxed text-muted">{entry.data.description}</p>
      </header>

      {
        entry.data.image && (
          <img
            src={entry.data.image}
            alt={entry.data.imageAlt ?? ''}
            class="mt-10 aspect-[16/9] w-full object-cover"
            loading="eager"
          />
        )
      }

      <div
        class="prose prose-neutral mt-10 max-w-none prose-headings:font-display prose-headings:font-normal prose-a:text-accent-blue prose-strong:text-ink"
      >
        <Content />
      </div>
    </div>
  </article>
</PageLayout>
