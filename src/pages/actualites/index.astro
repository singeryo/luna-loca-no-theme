---
import NewsCard from '../../components/NewsCard.astro';
import Button from '../../components/ui/Button.astro';
import SectionHeading from '../../components/ui/SectionHeading.astro';
import PageLayout from '../../layouts/PageLayout.astro';
import { getPublishedNews } from '../../lib/news';

const entries = await getPublishedNews();
---

<PageLayout
  title="Actualités"
  description="Historique des actualités de l’association : cours, spectacles et événements."
>
  <section class="section-pad">
    <div class="container-narrow">
      <div class="mb-12 flex flex-col gap-6 sm:flex-row sm:items-end sm:justify-between">
        <SectionHeading
          eyebrow="Archives"
          title="Toutes les actualités"
          description="L’historique des annonces publiées par l’association."
        />
        <Button href="/" variant="secondary" class="shrink-0 self-start sm:self-auto">
          Retour à l’accueil
        </Button>
      </div>

      {
        entries.length === 0 ? (
          <p class="border border-dashed border-line px-6 py-12 text-center text-muted">
            Aucune actualité pour le moment.
          </p>
        ) : (
          <div class="border-b border-ink">
            {entries.map((entry) => (
              <NewsCard entry={entry} />
            ))}
          </div>
        )
      }
    </div>
  </section>
</PageLayout>
