---
import { navLinks, site } from '../data/site';
import { resolveSectionHref } from '../lib/nav';
import AccentBar from './AccentBar.astro';

const pathname = Astro.url.pathname;
---

<header id="site-header" class="sticky top-0 z-50 bg-paper">
  <AccentBar />
  <div class="border-b border-line">
    <div class="container-narrow flex h-16 items-center justify-between gap-4 px-4 sm:px-6 lg:px-8">
      <a href="/" class="flex items-center gap-3" aria-label={`${site.name} — Accueil`}>
        <span class="h-2.5 w-2.5 bg-accent-red" aria-hidden="true"></span>
        <span class="font-display text-[1.7rem] leading-none tracking-tight">{site.name}</span>
      </a>

      <nav class="hidden items-center gap-8 md:flex" aria-label="Navigation principale">
        {
          navLinks.map((link) => (
            <a
              href={resolveSectionHref(link.href, pathname)}
              class={link.emphasis ? 'nav-emphasis' : 'nav-link'}
              data-nav-link
            >
              {link.label}
            </a>
          ))
        }
      </nav>

      <button
        type="button"
        id="menu-toggle"
        class="inline-flex items-center justify-center border border-ink px-3 py-2 text-sm font-medium md:hidden"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        Menu
      </button>
    </div>

    <div id="mobile-menu" class="border-t border-line md:hidden" hidden>
      <nav class="container-narrow flex flex-col gap-1 px-4 py-4 sm:px-6" aria-label="Navigation mobile">
        {
          navLinks.map((link) => (
            <a
              href={resolveSectionHref(link.href, pathname)}
              class:list={[
                link.emphasis ? 'nav-emphasis mt-2 text-center' : 'nav-link self-start px-1 py-2.5',
              ]}
              data-nav-link
            >
              {link.label}
            </a>
          ))
        }
      </nav>
    </div>
  </div>
</header>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');

  function setMenuOpen(open: boolean) {
    if (!toggle || !menu) return;
    toggle.setAttribute('aria-expanded', String(open));
    toggle.textContent = open ? 'Fermer' : 'Menu';
    menu.hidden = !open;
  }

  toggle?.addEventListener('click', () => {
    setMenuOpen(toggle.getAttribute('aria-expanded') !== 'true');
  });

  document.querySelectorAll('[data-nav-link]').forEach((link) => {
    link.addEventListener('click', () => setMenuOpen(false));
  });

  const desktop = window.matchMedia('(min-width: 768px)');
  desktop.addEventListener('change', (event) => {
    if (event.matches) setMenuOpen(false);
  });

  const pairs = [...document.querySelectorAll<HTMLAnchorElement>('[data-nav-link]')].flatMap(
    (link) => {
      const id = (link.getAttribute('href') ?? '').split('#')[1];
      const section = id ? document.getElementById(id) : null;
      return section ? [{ link, section }] : [];
    },
  );

  const seen = new Set<Element>();
  const sections = pairs
    .map((pair) => pair.section)
    .filter((section) => (seen.has(section) ? false : seen.add(section)));

  if (sections.length > 0) {
    const observer = new IntersectionObserver(
      (entries) => {
        const visible = entries
          .filter((entry) => entry.isIntersecting)
          .sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0];
        if (!visible) return;

        pairs.forEach(({ link, section }) => {
          link.classList.toggle('nav-active', section === visible.target);
        });
      },
      { rootMargin: '-45% 0px -45% 0px', threshold: [0, 0.25, 0.5] },
    );

    sections.forEach((section) => observer.observe(section));
  }
</script>
