---
interface Props {
  href?: string;
  variant?: 'primary' | 'secondary' | 'ghost' | 'invert';
  type?: 'button' | 'submit' | 'reset';
  class?: string;
}

const { href, variant = 'primary', type = 'button', class: className = '' } = Astro.props;

const variants = {
  primary: 'bg-ink text-paper hover:bg-accent-red',
  secondary: 'border border-ink bg-transparent text-ink hover:bg-ink hover:text-paper',
  ghost: 'bg-transparent px-0 text-ink underline-offset-4 hover:text-accent-red hover:underline',
  invert: 'bg-paper text-ink hover:bg-accent-red hover:text-paper',
};

const classes = [
  'inline-flex items-center justify-center gap-2 px-5 py-2.5 text-sm font-medium tracking-wide transition-colors',
  variants[variant],
  className,
].join(' ');
---

{
  href ? (
    <a href={href} class={classes}>
      <slot />
    </a>
  ) : (
    <button type={type} class={classes}>
      <slot />
    </button>
  )
}
