---
interface Props {
  id?: string;
  eyebrow?: string;
  title: string;
  description?: string;
}

const { id, eyebrow, title, description } = Astro.props;
---

<div class="max-w-2xl">
  {
    eyebrow && (
      <p class="mb-3 text-xs font-medium uppercase tracking-[0.22em] text-accent-red">{eyebrow}</p>
    )
  }
  <h2 id={id} class="font-display text-4xl leading-[1.05] text-ink sm:text-5xl">{title}</h2>
  {
    description && (
      <p class="mt-4 text-base leading-relaxed text-muted sm:text-lg">{description}</p>
    )
  }
</div>
