---
interface Props {
  id?: string;
  eyebrow?: string;
  title: string;
  description?: string;
  align?: 'left' | 'center';
}

const { id, eyebrow, title, description, align = 'left' } = Astro.props;
const alignment = align === 'center' ? 'text-center mx-auto' : 'text-left';
---

<div class={`max-w-2xl ${alignment}`}>
  {
    eyebrow && (
      <p class="mb-3 text-xs font-semibold uppercase tracking-[0.2em] text-accent-red">
        {eyebrow}
      </p>
    )
  }
  <h2 id={id} class="text-3xl font-bold tracking-tight text-ink sm:text-4xl">{title}</h2>
  {
    description && (
      <p class="mt-4 text-base leading-relaxed text-muted sm:text-lg">{description}</p>
    )
  }
</div>
