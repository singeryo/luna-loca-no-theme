---
import { heroSlides } from '../data/site';
import Button from './ui/Button.astro';
import Motif from './Motif.astro';

const total = String(heroSlides.length).padStart(2, '0');
---

<section id="accueil" class="relative bg-ink text-paper" aria-roledescription="carrousel" aria-label="Présentation">
  <div class="relative min-h-[calc(100svh-4.25rem)]">
    {
      heroSlides.map((slide, index) => (
        <article
          class:list={[
            'absolute inset-0',
            slide.tone === 'light' ? 'bg-paper text-ink' : 'bg-ink text-paper',
          ]}
          data-hero-slide
          data-active={index === 0 || undefined}
          aria-hidden={index === 0 ? 'false' : 'true'}
          inert={index === 0 ? undefined : true}
        >
          <div class="container-narrow flex h-full flex-col px-4 sm:flex-row sm:items-stretch sm:px-6 lg:px-8">
            <div class="order-2 flex flex-1 flex-col justify-end pb-28 pt-6 sm:order-1 sm:py-16 sm:pr-10">
              <p class="text-xs font-medium uppercase tracking-[0.28em] text-accent-red">{slide.kicker}</p>
              {index === 0 ? (
                <h1 class="mt-4 max-w-xl font-display text-[2.7rem] leading-[0.95] sm:text-6xl lg:text-7xl">
                  {slide.title}
                </h1>
              ) : (
                <h2 class="mt-4 max-w-xl font-display text-[2.7rem] leading-[0.95] sm:text-6xl lg:text-7xl">
                  {slide.title}
                </h2>
              )}
              <p
                class:list={[
                  'mt-5 max-w-md text-base leading-relaxed sm:text-lg',
                  slide.tone === 'light' ? 'text-muted' : 'text-paper/80',
                ]}
              >
                {slide.subtitle}
              </p>
              <div class="mt-8">
                <Button href={slide.cta.href} variant={slide.tone === 'light' ? 'primary' : 'invert'}>
                  {slide.cta.label}
                </Button>
              </div>
            </div>
            <div class="order-1 h-40 w-full sm:order-2 sm:h-auto sm:w-[42%] sm:py-8">
              <Motif name={slide.motif} />
            </div>
          </div>
        </article>
      ))
    }

    <div class="absolute inset-x-0 bottom-0 z-20 border-t border-paper/15 bg-ink text-paper">
      <div class="container-narrow flex items-center gap-4 px-4 py-4 sm:px-6 lg:px-8">
        <p class="shrink-0 font-display text-2xl leading-none tabular-nums">
          <span data-hero-index>01</span>
          <span class="text-paper/40"> / {total}</span>
        </p>
        <div class="h-px flex-1 bg-paper/20" aria-hidden="true">
          <div data-hero-progress class="h-px bg-accent-red" style={`width: ${100 / heroSlides.length}%`}></div>
        </div>
        <div class="flex shrink-0 gap-2">
          <button
            type="button"
            data-hero-prev
            class="border border-paper/30 px-3 py-2 text-xs font-medium uppercase tracking-[0.14em] hover:border-paper"
          >
            Préc.
          </button>
          <button
            type="button"
            data-hero-next
            class="border border-paper/30 px-3 py-2 text-xs font-medium uppercase tracking-[0.14em] hover:border-paper"
          >
            Suiv.
          </button>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  [data-hero-slide] {
    opacity: 0;
    z-index: 0;
    transition: opacity 700ms ease;
  }

  [data-hero-slide][data-active] {
    opacity: 1;
    z-index: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    [data-hero-slide] {
      transition: none;
    }
  }
</style>

<script>
  const root = document.getElementById('accueil');
  const slides = [...document.querySelectorAll<HTMLElement>('[data-hero-slide]')];
  const indexLabel = document.querySelector<HTMLElement>('[data-hero-index]');
  const progress = document.querySelector<HTMLElement>('[data-hero-progress]');
  const prev = document.querySelector<HTMLButtonElement>('[data-hero-prev]');
  const next = document.querySelector<HTMLButtonElement>('[data-hero-next]');
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  let current = 0;
  let timer = 0;

  function show(index: number) {
    if (slides.length === 0) return;
    current = (index + slides.length) % slides.length;

    slides.forEach((slide, i) => {
      const active = i === current;
      slide.toggleAttribute('data-active', active);
      slide.toggleAttribute('inert', !active);
      slide.setAttribute('aria-hidden', active ? 'false' : 'true');
    });

    if (indexLabel) indexLabel.textContent = String(current + 1).padStart(2, '0');
    if (progress) progress.style.width = `${((current + 1) / slides.length) * 100}%`;
  }

  function stopAutoplay() {
    window.clearInterval(timer);
    timer = 0;
  }

  function startAutoplay() {
    stopAutoplay();
    if (reduceMotion || slides.length < 2) return;
    timer = window.setInterval(() => show(current + 1), 7000);
  }

  prev?.addEventListener('click', () => {
    show(current - 1);
    startAutoplay();
  });

  next?.addEventListener('click', () => {
    show(current + 1);
    startAutoplay();
  });

  root?.addEventListener('mouseenter', stopAutoplay);
  root?.addEventListener('mouseleave', startAutoplay);
  root?.addEventListener('focusin', stopAutoplay);
  root?.addEventListener('focusout', startAutoplay);

  document.addEventListener('visibilitychange', () => {
    if (document.hidden) stopAutoplay();
    else startAutoplay();
  });

  startAutoplay();
</script>
