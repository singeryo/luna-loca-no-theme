---
import { getLatestNews } from '../lib/news';
import NewsCard from './NewsCard.astro';
import Button from './ui/Button.astro';
import SectionHeading from './ui/SectionHeading.astro';

const latest = await getLatestNews();
const [featured, ...rest] = latest;
---

<section id="actualites" class="section-pad bg-white" aria-labelledby="news-title">
  <div class="container-narrow">
    <div class="mb-12 flex flex-col gap-6 sm:flex-row sm:items-end sm:justify-between">
      <SectionHeading
        id="news-title"
        eyebrow="Actualités"
        title="Les dernières nouvelles"
        description="Cinq annonces récentes. L’historique complet est sur une page à part."
      />
      <Button href="/actualites/" variant="secondary" class="shrink-0 self-start sm:self-auto">
        Tout l’historique
      </Button>
    </div>

    {
      latest.length === 0 ? (
        <p class="border border-dashed border-line px-6 py-12 text-center text-muted">
          Aucune actualité pour le moment.
        </p>
      ) : (
        <div class="border-b border-ink">
          {featured && <NewsCard entry={featured} featured />}
          {rest.map((entry) => (
            <NewsCard entry={entry} />
          ))}
        </div>
      )
    }
  </div>
</section>
