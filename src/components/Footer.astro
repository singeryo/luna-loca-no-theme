---
import { navLinks, site } from '../data/site';

const isHome = Astro.url.pathname === '/' || Astro.url.pathname === '';

function resolveHref(href: string) {
  if (href.startsWith('#') && !isHome) {
    return `/${href}`;
  }
  return href;
}
---

<footer class="mt-auto border-t border-line bg-ink text-paper">
  <div class="container-narrow section-pad grid gap-10 py-12 sm:grid-cols-2 lg:grid-cols-3 lg:py-14">
    <div>
      <p class="text-lg font-bold tracking-tight">{site.name}</p>
      <p class="mt-3 max-w-sm text-sm leading-relaxed text-paper/70">{site.tagline}</p>
    </div>

    <div>
      <p class="text-xs font-semibold uppercase tracking-[0.18em] text-accent-red">Navigation</p>
      <ul class="mt-4 space-y-2 text-sm text-paper/80">
        {
          navLinks.map((link) => (
            <li>
              <a class="hover:text-paper" href={resolveHref(link.href)}>
                {link.label}
              </a>
            </li>
          ))
        }
        <li>
          <a class="hover:text-paper" href="/actualites/">Actualités (historique)</a>
        </li>
      </ul>
    </div>

    <div>
      <p class="text-xs font-semibold uppercase tracking-[0.18em] text-accent-blue">Suivez-nous</p>
      <ul class="mt-4 space-y-2 text-sm text-paper/80">
        <li>
          <a class="hover:text-paper" href={site.social.instagram} rel="noopener noreferrer" target="_blank">
            Instagram
          </a>
        </li>
        <li>
          <a class="hover:text-paper" href={site.social.facebook} rel="noopener noreferrer" target="_blank">
            Facebook
          </a>
        </li>
        <li>
          <a class="hover:text-paper" href={`mailto:${site.email}`}>{site.email}</a>
        </li>
      </ul>
    </div>
  </div>

  <div class="border-t border-paper/10">
    <div class="container-narrow flex flex-col gap-2 px-4 py-5 text-xs text-paper/50 sm:flex-row sm:items-center sm:justify-between sm:px-6 lg:px-8">
      <p>© {new Date().getFullYear()} {site.name}. Association à but non lucratif.</p>
      <p>Site statique · Astro · Cloudflare</p>
    </div>
  </div>
</footer>
